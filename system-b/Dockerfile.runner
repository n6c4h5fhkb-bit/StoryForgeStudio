# Optional third-party sandbox image. Pin versions through build arguments.
FROM node:22-bookworm-slim
ARG CODEX_PACKAGE=@openai/codex
ARG PI_PACKAGE=@mariozechner/pi-coding-agent
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir httpx==0.28.1 Pillow==12.3.0 imageio-ffmpeg==0.6.0
RUN npm install -g "$CODEX_PACKAGE" "$PI_PACKAGE"
ENV HOME=/work/home TMPDIR=/work/tmp PYTHONUTF8=1
WORKDIR /work
